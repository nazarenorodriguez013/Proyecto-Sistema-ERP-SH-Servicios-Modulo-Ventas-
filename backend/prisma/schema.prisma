// Archivo de configuración del esquema de base de datos (Prisma)
// Documentación: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  correo        String   @unique
  contrasena    String
  rol           Rol      @default(VENDEDOR)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  ventas             Venta[]
  serviciosAsignados ServicioTecnico[]

  @@map("usuarios")
}

enum Rol {
  ADMIN
  VENDEDOR
  TECNICO
}

model Categoria {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique
  creadoEn DateTime @default(now()) @map("creado_en")

  productos Producto[]

  @@map("categorias")
}

model Producto {
  id            Int      @id @default(autoincrement())
  codigo        String?  @unique
  nombre        String
  descripcion   String?
  precioCosto   Float    @default(0) @map("precio_costo")
  precio        Float
  stock         Int      @default(0)
  stockMinimo   Int      @default(5) @map("stock_minimo")
  activo        Boolean  @default(true)
  categoriaId   Int      @map("categoria_id")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  categoria       Categoria          @relation(fields: [categoriaId], references: [id])
  detallesVenta   DetalleVenta[]
  usosEnServicios ServicioRepuesto[]

  @@map("productos")
}

// Presupuesto no se guarda como Venta: no descuenta stock ni genera deuda, solo se imprime.
// Cuenta Corriente es un medio de pago (campo medioPago), no un tipo de comprobante.
enum TipoComprobante {
  FACTURA
  REMITO
}

model Venta {
  id              Int             @id @default(autoincrement())
  total           Float
  tipoComprobante TipoComprobante @default(FACTURA) @map("tipo_comprobante")
  medioPago       String          @default("Efectivo") @map("medio_pago")
  montoRecibido   Float?          @map("monto_recibido")
  saldoAplicado   Float           @default(0) @map("saldo_aplicado")
  usuarioId       Int             @map("usuario_id")
  clienteId       Int?            @map("cliente_id")
  creadoEn        DateTime        @default(now()) @map("creado_en")

  usuario           Usuario            @relation(fields: [usuarioId], references: [id])
  cliente           Cliente?           @relation(fields: [clienteId], references: [id])
  detallesVenta     DetalleVenta[]
  movimientosCuenta MovimientoCuenta[]

  @@map("ventas")
}

model DetalleVenta {
  id             Int   @id @default(autoincrement())
  ventaId        Int   @map("venta_id")
  productoId     Int   @map("producto_id")
  cantidad       Int
  precioUnitario Float @map("precio_unitario")

  venta    Venta    @relation(fields: [ventaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("detalles_venta")
}

model Cliente {
  id            Int      @id @default(autoincrement())
  nombre        String
  documento     String?  @unique
  telefono      String?
  email         String?
  direccion     String?
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  ventas      Venta[]
  movimientos MovimientoCuenta[]
  servicios   ServicioTecnico[]

  @@map("clientes")
}

// Cuenta corriente del cliente: cada venta o servicio a cuenta suma deuda y cada pago la resta
enum TipoMovimiento {
  VENTA
  SERVICIO
  PAGO
}

model MovimientoCuenta {
  id         Int            @id @default(autoincrement())
  clienteId  Int            @map("cliente_id")
  tipo       TipoMovimiento
  concepto   String
  monto      Float
  ventaId    Int?           @map("venta_id")
  servicioId Int?           @map("servicio_id")
  creadoEn   DateTime       @default(now()) @map("creado_en")

  cliente  Cliente          @relation(fields: [clienteId], references: [id])
  venta    Venta?           @relation(fields: [ventaId], references: [id])
  servicio ServicioTecnico? @relation(fields: [servicioId], references: [id])

  @@map("movimientos_cuenta")
}

// Flujo simplificado: se crea EN_CURSO (con técnico y repuestos ya asignados) y se cierra al FINALIZADO,
// que es cuando se genera la factura/remito y se cobra. Antes de eso es solo un estimado.
enum EstadoServicio {
  EN_CURSO
  FINALIZADO
}

// Cuando el servicio lleva repuestos, retirarlos del depósito pasa por esta cola:
// PENDIENTE (recién creado) -> LISTO (el área de repuestos ya los preparó) -> RETIRADO
enum EstadoRetiro {
  PENDIENTE
  LISTO
  RETIRADO
}

model ServicioTecnico {
  id                   Int             @id @default(autoincrement())
  clienteId            Int             @map("cliente_id")
  tecnicoId            Int?            @map("tecnico_id")
  equipo               String
  descripcionFalla     String          @map("descripcion_falla")
  tareas               String?         @map("tareas")
  enGarantia           Boolean         @default(false) @map("en_garantia")
  costoManoObra        Float           @default(0) @map("costo_mano_obra")
  estado               EstadoServicio  @default(EN_CURSO)
  fechaEstimadaFin      DateTime?      @map("fecha_estimada_fin")
  tipoComprobante      TipoComprobante? @map("tipo_comprobante")
  medioPago            String?         @map("medio_pago")
  total                Float?
  saldoAplicado        Float           @default(0) @map("saldo_aplicado")
  proximoMantenimiento DateTime?       @map("proximo_mantenimiento")
  codigoRetiro         String?         @unique @map("codigo_retiro")
  estadoRetiro         EstadoRetiro?   @map("estado_retiro")
  fechaIngreso         DateTime        @default(now()) @map("fecha_ingreso")
  finalizadoEn         DateTime?       @map("entregado_en")

  cliente     Cliente            @relation(fields: [clienteId], references: [id])
  tecnico     Usuario?           @relation(fields: [tecnicoId], references: [id])
  repuestos   ServicioRepuesto[]
  movimientos MovimientoCuenta[]

  @@map("servicios_tecnicos")
}

// Repuestos del inventario usados en un servicio; el stock se descuenta al cargarlos (salen del depósito)
model ServicioRepuesto {
  id             Int   @id @default(autoincrement())
  servicioId     Int   @map("servicio_id")
  productoId     Int   @map("producto_id")
  cantidad       Int
  precioUnitario Float @map("precio_unitario")

  servicio ServicioTecnico @relation(fields: [servicioId], references: [id])
  producto Producto        @relation(fields: [productoId], references: [id])

  @@unique([servicioId, productoId])
  @@map("servicio_repuestos")
}
