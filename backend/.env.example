APP_NAME="SH Servicios"
APP_ENV=production
# php artisan key:generate
APP_KEY=
APP_DEBUG=false
# Dirección pública: se usa en los links de recuperación de contraseña
APP_URL=https://tu-dominio.com

LOG_CHANNEL=single
LOG_LEVEL=warning

# Base MySQL creada desde hPanel → Bases de datos
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Firma de las sesiones y cifrado de Google Authenticator. Para conservar la verificación en dos pasos
# configurada en el sistema anterior, usar el mismo valor que tenía JWT_SECRET allá
JWT_SECRET=

# Inicio de sesión con Google (opcional)
GOOGLE_CLIENT_ID=

# Mails (códigos de verificación y recuperación): Resend o el correo SMTP de Hostinger
RESEND_API_KEY=
MAIL_FROM="SH Servicios <no-responder@tu-dominio.com>"
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-responder@tu-dominio.com
MAIL_FROM_NAME="SH Servicios"
